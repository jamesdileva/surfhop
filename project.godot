; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Velocity"
config/description="Velocity Engine - a modular movement engine. First game: Velocity (bhop / air-strafe / surf time trials)."

[autoload]

SignalBus="*res://scripts/managers/SignalBus.gd"
GameManager="*res://scripts/managers/GameManager.gd"
InputManager="*res://scripts/managers/InputManager.gd"
TickManager="*res://scripts/managers/TickManager.gd"
UIManager="*res://scripts/managers/UIManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
AudioManager="*res://scripts/managers/AudioManager.gd"
LevelLoader="*res://scripts/managers/LevelLoader.gd"

[physics]

common/physics_fps=100
3d/default_angular_damp=0.0
3d/default_linear_damp=0.0

[rendering]

renderer/rendering_method="forward_plus"
